# =============================================================================
# Forex AI Master — configuration example. Copy to .env and fill in.
# NEVER commit .env. Secrets below are intentionally empty.
# =============================================================================

# --- Mode -------------------------------------------------------------------
# simulation | demo | live. LIVE is disabled by default and requires ALL of:
#   TRADING_MODE=live, LIVE_TRADING_ENABLED=true, the exact confirmation phrase,
#   a recent passing critical-test report on the current code, enough DEMO trades.
TRADING_MODE=simulation
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_PHRASE=
LIVE_MIN_DEMO_TRADES=50
LIVE_APPROVED_STRATEGIES=

# --- Account / market -------------------------------------------------------
ACCOUNT_CURRENCY=USD
INITIAL_BALANCE=100000
SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD
TIMEFRAMES=M5,M15,M30,H1,H4
ENTRY_TIMEFRAME=M15
# Smallest position and increment accepted by YOUR broker (units). 1000 = micro lot; some brokers accept 1.
MIN_TRADE_UNITS=1000
TRADE_UNITS_STEP=1000
CYCLE_INTERVAL_SECONDS=30

# --- Risk limits (percent of capital). The Master bot cannot change them. ---
RISK_MAX_RISK_PER_TRADE_PCT=0.25
RISK_MAX_EXCEPTIONAL_RISK_PER_TRADE_PCT=0.50
RISK_MAX_DAILY_LOSS_PCT=1.0
RISK_MAX_WEEKLY_LOSS_PCT=2.5
RISK_MAX_DRAWDOWN_PCT=5.0
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_TOTAL_OPEN_RISK_PCT=0.75
RISK_MAX_CURRENCY_EXPOSURE_PCT=0.50
RISK_MAX_CORRELATION=0.80
RISK_MIN_REWARD_RISK=1.5
RISK_MAX_SPREAD_PIPS=3.0
RISK_MAX_SPREAD_TO_STOP_RATIO=0.20
RISK_MAX_SLIPPAGE_PIPS=2.0
RISK_MAX_ATR_SPIKE_RATIO=3.0
RISK_MAX_MARGIN_USAGE_PCT=30.0
RISK_MIN_STOP_PIPS=5.0

# --- Session target (a target, never a guarantee; never changes risk) --------
TARGET_SESSION_PROFIT=1000
TARGET_ENABLED=true
# hold | breakeven | close_all
TARGET_REACHED_POLICY=breakeven
SESSION_START_UTC=07:00
SESSION_END_UTC=21:00
TRADE_ONLY_IN_SESSION=true

# --- Safety -----------------------------------------------------------------
# keep_with_stops | close_all
EMERGENCY_CLOSE_POLICY=keep_with_stops
BLOCK_WHEN_CALENDAR_UNAVAILABLE=true
NEWS_BLACKOUT_MINUTES_BEFORE=30
NEWS_BLACKOUT_MINUTES_AFTER=30
MAX_CONSECUTIVE_ERRORS=5

# --- Data -------------------------------------------------------------------
HISTORICAL_DATA_DIR=data/historical
# csv (verified history) | synthetic (pipeline demo only, no predictive value)
SIMULATION_DATA_SOURCE=csv
SIMULATION_STEP_SECONDS=1.0
SIMULATION_START=
STRATEGY_VALIDATION_PATH=var/strategy_validation.json
ECONOMIC_CALENDAR_PATH=
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///var/forex_ai_master.db
# Docker Compose overrides DATABASE_URL with PostgreSQL using POSTGRES_PASSWORD below.

# --- Dashboard auth ---------------------------------------------------------
DASHBOARD_ADMIN_USERNAME=admin
# bcrypt hash generated with: python scripts/hash_password.py
DASHBOARD_ADMIN_PASSWORD_HASH=
# >= 32 chars, generated with: python scripts/generate_secret.py
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_RATE_LIMIT_PER_MINUTE=120

# --- Alerts -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Broker (no real connector shipped yet: see docs/BROKER_SETUP.md) --------
BROKER_NAME=simulated
BROKER_API_KEY=
BROKER_ACCOUNT_ID=
BROKER_ENVIRONMENT=practice
POSTGRES_PASSWORD=
